generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { OWNER ADMIN REPORTER }
enum UserStatus { ACTIVE SUSPENDED }
enum ApplicationStatus { PENDING ACCEPTED REJECTED DELETED SUSPENDED }
enum ArticleStatus { DRAFT PENDING_REVIEW CORRECTION_REQUIRED REJECTED PUBLISHED UNPUBLISHED }
enum AdStatus { ACTIVE INACTIVE SCHEDULED EXPIRED }
enum AdType { CODE IMAGE TEXT PLACEHOLDER }

enum AuditAction { LOGIN LOGOUT REPORTER_ACCEPT REPORTER_REJECT REPORTER_DELETE REPORTER_SUSPEND REPORTER_REACTIVATE REPORT_APPROVE REPORT_REJECT REPORT_CORRECTION ARTICLE_CREATE ARTICLE_EDIT ARTICLE_DELETE ARTICLE_PUBLISH ARTICLE_UNPUBLISH AD_CREATE AD_EDIT AD_DELETE ADMIN_CREATE ADMIN_SUSPEND ADMIN_REACTIVATE SETTINGS_UPDATE }

model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 name String
 role Role
 status UserStatus @default(ACTIVE)
 phone String?
 profilePhoto String?
 address String?
 biography String?
 permissions Json?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 articles Article[]
 sessions Session[]
 applications ReporterApplication[] @relation("ApplicationReviewer")
 auditLogs AuditLog[]
}
model Session {
 id String @id @default(cuid())
 userId String
 tokenHash String @unique
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId])
}
model ReporterApplication {
 id String @id @default(cuid())
 fullName String
 email String
 phone String
 passwordHash String
 profilePhoto String?
 address String?
 biography String?
 status ApplicationStatus @default(PENDING)
 adminDecision String?
 adminNotes String?
 reviewedAt DateTime?
 reviewedById String?
 createdAt DateTime @default(now())
 reviewer User? @relation("ApplicationReviewer", fields:[reviewedById], references:[id], onDelete:SetNull)
 @@index([status,createdAt])
}
model Article {
 id String @id @default(cuid())
 title String
 slug String @unique
 summary String?
 content String
 categoryId String
 reporterId String?
 featuredImage String?
 gallery Json?
 videoUrl String?
 sourceUrl String?
 tags String[]
 status ArticleStatus @default(DRAFT)
 seoTitle String?
 metaDescription String?
 canonicalUrl String?
 views Int @default(0)
 isBreaking Boolean @default(false)
 publishedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 category Category @relation(fields:[categoryId], references:[id])
 reporter User? @relation(fields:[reporterId], references:[id], onDelete:SetNull)
 @@index([status,publishedAt])
 @@index([categoryId,status])
}
model Category {
 id String @id @default(cuid())
 name String @unique
 slug String @unique
 articles Article[]
 createdAt DateTime @default(now())
}
model Media {
 id String @id @default(cuid())
 url String
 filename String
 mimeType String
 size Int
 altText String?
 caption String?
 uploadedById String?
 createdAt DateTime @default(now())
}
model Advertisement {
 id String @id @default(cuid())
 name String
 type AdType
 status AdStatus @default(INACTIVE)
 codeHtml String?
 imageUrl String?
 targetUrl String?
 altText String?
 title String?
 description String?
 buttonText String?
 placement String?
 startsAt DateTime?
 endsAt DateTime?
 priority Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model PasswordReset {
 id String @id @default(cuid())
 userId String
 otpHash String
 expiresAt DateTime
 attempts Int @default(0)
 usedAt DateTime?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,expiresAt])
}
model VisitorEvent {
 id String @id @default(cuid())
 timestamp DateTime @default(now())
 userAgent String?
 pageUrl String
 referrer String?
 deviceType String?
 browser String?
 operatingSystem String?
}
model BreakingNews {
 id String @id @default(cuid())
 text String
 articleId String?
 active Boolean @default(true)
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(cuid())
 userId String?
 action AuditAction
 targetType String?
 targetId String?
 metadata Json?
 createdAt DateTime @default(now())
 user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
 @@index([createdAt])
}